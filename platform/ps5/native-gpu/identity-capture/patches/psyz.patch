+#ifdef PE_PS5_GPU_NATIVE
+int Psyz_GpuCaptureNativeIdentityWords(unsigned short *words, unsigned char *known, unsigned count) {
+    const unsigned char *shadow_known = NULL;
+    const unsigned short *shadow;
+    unsigned valid = 0;
+    if (!words || !known || count != 1024u * 512u) return 0;
+    memset(words, 0, count * sizeof(*words)); memset(known, 0, count);
+    if (UseSoftwareBackend() || !device || !vram_render || gpu_failed) return 0;
+    /* Game-thread only: drain libgpu packets, then all native GPU primitives.
+     * Download submits the ordered copy and waits for its fence before mapping. */
+    Draw_FlushBuffer(); Psyz_GpuExeque(); Draw_FlushBuffer();
+    shadow = Psyz_GpuGetVramCopy(&shadow_known);
+    if (!shadow || !shadow_known || gpu_failed) return 0;
+    unsigned char *rgba = malloc(1024u * 512u * 4u);
+    if (!rgba) return 0;
+    if (!DownloadVramRegionAsRGBA8888(0, 0, 1024, 512, rgba) || gpu_failed) { free(rgba); return 0; }
+    ConvertRgba8888ToRgb5551(rgba, words, count); free(rgba);
+    /* Readback is actual native GPU storage, not an authoritative complete PS1
+     * RAM image. Export ONLY upload-known words matching original word data;
+     * never expose uninitialized/unknown GPU allocation contents. */
+    for (unsigned i = 0; i < count; ++i) {
+        if (shadow_known[i] == 1 && words[i] == shadow[i]) { known[i] = 1; ++valid; }
+        else words[i] = 0;
+    }
+    INFOF("identity native readback: %u/%u known matching upload words; partial, not complete VRAM", valid, count);
+    return valid != 0;
+}
+#endif
