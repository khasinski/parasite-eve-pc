# Optional private diagnostic; no capture is requested by enabling compilation.
option(PE_PS5_IDENTITY_CAPTURE "Compile human-gated partial GPU identity capture" OFF)
if(NOT PE_PS5_IDENTITY_CAPTURE)
  return()
endif()
if(NOT PE_PS5_GAME OR NOT TARGET parasite-eve-original-entity-textures OR NOT TARGET SDL3::SDL3 OR NOT DEFINED PSYZ_DIR)
  message(FATAL_ERROR "Identity capture requires native PS5 game, entity-texture target, SDL3::SDL3 and PSYZ_DIR")
endif()
string(LENGTH "${PE_PS5_IDENTITY_CAPTURE_BUILD}" _capture_stamp_length)
if(_capture_stamp_length LESS 1 OR _capture_stamp_length GREATER 81 OR NOT "${PE_PS5_IDENTITY_CAPTURE_BUILD}" MATCHES "^[A-Za-z0-9_-]+$")
  message(FATAL_ERROR "Set PE_PS5_IDENTITY_CAPTURE_BUILD to 1..81 safe ASCII letters/digits/underscore/hyphen")
endif()
function(_capture_require_source file expected)
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "Identity capture source missing: ${file}")
  endif()
  file(READ "${file}" _capture_text)
  string(REPLACE "\r\n" "\n" _capture_text "${_capture_text}")
  string(SHA256 _capture_hash "${_capture_text}")
  if(NOT _capture_hash STREQUAL expected)
    message(FATAL_ERROR "Identity capture source differs from reviewed addon: ${file}")
  endif()
endfunction()
_capture_require_source("${CMAKE_SOURCE_DIR}/src/main/scene/room_load.c" "1ef51212793b08fba07050ca3b0b020db8585bf6b3f9fad379ea8cc7b4043ea4")
_capture_require_source("${CMAKE_SOURCE_DIR}/include/pe_texture_identity_capture.h" "4b5cc767ad904709294277731eadc81c95f9476e64bed62b7af1094709a1f856")
_capture_require_source("${PSYZ_DIR}/psyz/include/psyz/gpu.h" "0a8ce64524896fc656f32062e9bd480c1245624271902adc7f994e97c9f53cc4")
_capture_require_source("${PSYZ_DIR}/psyz/src/platform/sdl3_gpu.c" "e9e97ba30c7761082a430c9ea777688c87cc8907af0d588afec23544e489abe0")
target_compile_definitions(parasite-eve-original-entity-textures PRIVATE PE_PS5_TEXTURE_IDENTITY_CAPTURE=1 PE_TEXTURE_IDENTITY_BUILD="${PE_PS5_IDENTITY_CAPTURE_BUILD}")
