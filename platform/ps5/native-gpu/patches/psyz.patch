+    SDL_DrawGPUPrimitives(rp,3,1,0,0);SDL_EndGPURenderPass(rp);return true;
+}
+SDL_GPUTexture *CpeFsr1_Record(CpeFsr1 *s,SDL_GPUCommandBuffer *cmd,
+    SDL_GPUTexture *in,Uint32 iw,Uint32 ih,Uint32 ow,Uint32 oh,float sharp) {
+    if(!s||!s->enabled)return NULL;
+    if(!cmd||!in||!iw||!ih||iw>ow||ih>oh||!isfinite(sharp)||sharp<0||sharp>2){
+        SDL_SetError("FSR1 invalid viewport or RCAS sharpness");return NULL;
+    }
+    if(in==s->intermediate||in==s->output){SDL_SetError("FSR1 input aliases output");return NULL;}
+    if(!targets(s,ow,oh))return NULL;
+    AU1 c0[4],c1[4],c2[4],c3[4],rcas[4];Uint32 easu[16];
+    FsrEasuCon(c0,c1,c2,c3,(float)iw,(float)ih,(float)iw,(float)ih,(float)ow,(float)oh);
+    memcpy(easu,c0,16);memcpy(easu+4,c1,16);memcpy(easu+8,c2,16);memcpy(easu+12,c3,16);
+    FsrRcasCon(rcas,sharp);
+    if(!pass(s,cmd,in,s->intermediate,s->easu,easu,sizeof(easu)))return NULL;
+    if(!pass(s,cmd,s->intermediate,s->output,s->rcas,rcas,sizeof(rcas)))return NULL;
+    return s->output;
+}
+void CpeFsr1_Destroy(CpeFsr1 *s){
+    if(!s)return;
+    if(s->intermediate)SDL_ReleaseGPUTexture(s->device,s->intermediate);
+    if(s->output)SDL_ReleaseGPUTexture(s->device,s->output);
+    if(s->sampler)SDL_ReleaseGPUSampler(s->device,s->sampler);
+    if(s->easu)SDL_ReleaseGPUGraphicsPipeline(s->device,s->easu);
+    if(s->rcas)SDL_ReleaseGPUGraphicsPipeline(s->device,s->rcas);
+    SDL_free(s);
+}
diff --git a/psyz/src/platform/fsr1/cpe_fsr1.h b/psyz/src/platform/fsr1/cpe_fsr1.h
new file mode 100644
index 0000000..4a5950a
--- /dev/null
+++ b/psyz/src/platform/fsr1/cpe_fsr1.h
@@ -0,0 +1,25 @@
+#ifndef CPE_FSR1_H
+#define CPE_FSR1_H
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_gpu.h>
+// Isolated integration prototype, not linked into the playable game.
+// Call only on the renderer thread, outside any active copy/render pass.
+// Default is disabled. Original presentation remains the caller's fallback.
+typedef struct CpeFsr1 CpeFsr1;
+CpeFsr1 *CpeFsr1_Create(SDL_GPUDevice *device);
+void CpeFsr1_SetEnabled(CpeFsr1 *state, bool enabled);
+// Input must be a dedicated, compact, single-sample SDR UNORM texture with
+// SAMPLER usage. Do NOT pass the VRAM atlas or a cropped subregion: copy the
+// exact already-composed game rectangle to its own texture first. UI is drawn
+// AFTER the returned image is composed into the aspect-preserving destination.
+// Input RGB must already be display-referred (no sRGB sampler conversion).
+// Both input dimensions <= output dimensions. No downscale or frame generation.
+// sharpness_stops: 0 strongest RCAS, 2 weak. Errors never submit/cancel cmd.
+// NULL means no FSR output: caller must choose original presentation or cancel
+// its unsubmitted frame; no raw/unfiltered image is labelled FSR by this API.
+SDL_GPUTexture *CpeFsr1_Record(CpeFsr1 *state, SDL_GPUCommandBuffer *cmd,
+    SDL_GPUTexture *input, Uint32 input_w, Uint32 input_h,
+    Uint32 output_w, Uint32 output_h, float sharpness_stops);
+// Caller retains device until destroyed, after outstanding commands retire.
+void CpeFsr1_Destroy(CpeFsr1 *state);
+#endif
diff --git a/psyz/src/platform/fsr1/shaders/fsr1_easu.frag b/psyz/src/platform/fsr1/shaders/fsr1_easu.frag
new file mode 100644
index 0000000..48592ab
--- /dev/null
+++ b/psyz/src/platform/fsr1/shaders/fsr1_easu.frag
@@ -0,0 +1,21 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+// AMD FSR1 EASU, full precision. See third_party/fsr1/LICENSE.txt.
+layout(set=2,binding=0) uniform sampler2D sourceImage;
+layout(set=3,binding=0,std140) uniform Constants {
+    uvec4 c0; uvec4 c1; uvec4 c2; uvec4 c3;
+};
+layout(location=0) out vec4 resultColor;
+#define A_GPU 1
+#define A_GLSL 1
+#include "ffx_a.h"
+#define FSR_EASU_F 1
+AF4 FsrEasuRF(AF2 p) { return textureGather(sourceImage,p,0); }
+AF4 FsrEasuGF(AF2 p) { return textureGather(sourceImage,p,1); }
+AF4 FsrEasuBF(AF2 p) { return textureGather(sourceImage,p,2); }
+#include "ffx_fsr1.h"
+void main() {
+    AF3 c;
+    FsrEasuF(c, AU2(gl_FragCoord.xy), c0,c1,c2,c3);
+    resultColor=vec4(c,1.0);
+}
diff --git a/psyz/src/platform/fsr1/shaders/fsr1_rcas.frag b/psyz/src/platform/fsr1/shaders/fsr1_rcas.frag
