+ q1.x+=ex;q1.fx+=ex*(ratio-1);q1.y+=ey;
+ q2.x+=ex+ox;q2.fx+=(ex+ox)*(ratio-1);q2.y+=ey+oy;
+ q3.x+=ox;q3.fx+=ox*(ratio-1);q3.y+=oy;
