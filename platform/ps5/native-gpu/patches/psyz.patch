diff --git a/psyz/src/platform/movie_blur.frag b/psyz/src/platform/movie_blur.frag
new file mode 100644
index 0000000..d94e8d3
--- /dev/null
+++ b/psyz/src/platform/movie_blur.frag
@@ -0,0 +1,15 @@
+#version 450
+// Project original separable nine-tap Gaussian background blur.
+layout(set=2,binding=0) uniform sampler2D image;
+layout(set=3,binding=0,std140) uniform Parameters {vec4 step_dim;};
+layout(location=0) out vec4 colour;
+void main(){
+    vec2 uv=gl_FragCoord.xy/vec2(textureSize(image,0));
+    vec2 d=step_dim.xy;
+    vec3 c=texture(image,uv).rgb*0.2270270270;
+    c+=(texture(image,uv+d).rgb+texture(image,uv-d).rgb)*0.1945945946;
+    c+=(texture(image,uv+d*2).rgb+texture(image,uv-d*2).rgb)*0.1216216216;
+    c+=(texture(image,uv+d*3).rgb+texture(image,uv-d*3).rgb)*0.0540540541;
+    c+=(texture(image,uv+d*4).rgb+texture(image,uv-d*4).rgb)*0.0162162162;
+    colour=vec4(c*step_dim.z,1);
+}
diff --git a/psyz/src/platform/movie_blur.h b/psyz/src/platform/movie_blur.h
new file mode 100644
index 0000000..b8108be
--- /dev/null
+++ b/psyz/src/platform/movie_blur.h
@@ -0,0 +1,54 @@
+// Project original optional native RGB24 backdrop. No frame submission/waits.
+#include "movie_blur_shaders.h"
+static int movie_blur_requested,movie_blur_failed,movie_blur_status=-1;
+static SDL_GPUTexture *movie_blur_input,*movie_blur_temp,*movie_blur_output;
+static SDL_GPUGraphicsPipeline *movie_blur_pipeline;
+static SDL_GPUSampler *movie_blur_sampler;
+static Uint32 movie_blur_w,movie_blur_h;
+static unsigned movie_blur_log_count;
+void Psyz_VideoSetMovieBlur(int enabled){enabled=enabled!=0;if(enabled!=movie_blur_requested){movie_blur_requested=enabled;movie_blur_failed=0;movie_blur_status=-1;INFOF("Movie backdrop requested=%d original-center-aspect=preserved",enabled);}}
+static void MovieBlurLog(int status){if(status!=movie_blur_status&&movie_blur_log_count<32){INFOF("Movie backdrop requested=%d effective=%s stage=RGB24-movie-or-still input=%ux%u rendered_output=unobserved",movie_blur_requested,status==1?"blur-commands-recorded":status==2?"original-fallback":"original-bars-or-no-bars",movie_blur_w,movie_blur_h);movie_blur_log_count++;movie_blur_status=status;}}
+static void MovieBlurDestroy(void){
+    if(movie_blur_input)SDL_ReleaseGPUTexture(device,movie_blur_input);
+    if(movie_blur_temp)SDL_ReleaseGPUTexture(device,movie_blur_temp);
+    if(movie_blur_output)SDL_ReleaseGPUTexture(device,movie_blur_output);
+    if(movie_blur_pipeline)SDL_ReleaseGPUGraphicsPipeline(device,movie_blur_pipeline);
+    if(movie_blur_sampler)SDL_ReleaseGPUSampler(device,movie_blur_sampler);
+    movie_blur_input=movie_blur_temp=movie_blur_output=NULL;movie_blur_pipeline=NULL;movie_blur_sampler=NULL;movie_blur_w=movie_blur_h=0;
+}
+static bool MovieBlurPrepare(Uint32 w,Uint32 h){
+    if(!w||!h||w>256||h>256)return false;
+    if(!movie_blur_pipeline){
+        SDL_GPUShaderCreateInfo si={0};si.code=cpe_fullscreen_vert;si.code_size=sizeof(cpe_fullscreen_vert);si.entrypoint="main";si.format=SDL_GPU_SHADERFORMAT_SPIRV;si.stage=SDL_GPU_SHADERSTAGE_VERTEX;
+        SDL_GPUShader *vs=SDL_CreateGPUShader(device,&si);si.code=cpe_movie_blur_frag;si.code_size=sizeof(cpe_movie_blur_frag);si.stage=SDL_GPU_SHADERSTAGE_FRAGMENT;si.num_samplers=1;si.num_uniform_buffers=1;
+        SDL_GPUShader *fs=SDL_CreateGPUShader(device,&si);
+        if(vs&&fs){SDL_GPUColorTargetDescription ct={0};ct.format=SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;SDL_GPUGraphicsPipelineCreateInfo pi={0};pi.vertex_shader=vs;pi.fragment_shader=fs;pi.primitive_type=SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;pi.rasterizer_state.fill_mode=SDL_GPU_FILLMODE_FILL;pi.multisample_state.sample_count=SDL_GPU_SAMPLECOUNT_1;pi.target_info.color_target_descriptions=&ct;pi.target_info.num_color_targets=1;movie_blur_pipeline=SDL_CreateGPUGraphicsPipeline(device,&pi);}
+        if(vs)SDL_ReleaseGPUShader(device,vs);if(fs)SDL_ReleaseGPUShader(device,fs);
+        if(!movie_blur_pipeline)return false;
+    }
+    if(!movie_blur_sampler){SDL_GPUSamplerCreateInfo si={0};si.min_filter=si.mag_filter=SDL_GPU_FILTER_LINEAR;si.address_mode_u=si.address_mode_v=si.address_mode_w=SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;movie_blur_sampler=SDL_CreateGPUSampler(device,&si);if(!movie_blur_sampler)return false;}
+    if(movie_blur_w==w&&movie_blur_h==h&&movie_blur_input&&movie_blur_temp&&movie_blur_output)return true;
+    SDL_GPUTextureCreateInfo ti={0};ti.type=SDL_GPU_TEXTURETYPE_2D;ti.format=SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;ti.usage=SDL_GPU_TEXTUREUSAGE_SAMPLER|SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;ti.width=w;ti.height=h;ti.layer_count_or_depth=1;ti.num_levels=1;ti.sample_count=SDL_GPU_SAMPLECOUNT_1;
+    SDL_GPUTexture *a=SDL_CreateGPUTexture(device,&ti),*b=SDL_CreateGPUTexture(device,&ti),*c=SDL_CreateGPUTexture(device,&ti);
+    if(!a||!b||!c){if(a)SDL_ReleaseGPUTexture(device,a);if(b)SDL_ReleaseGPUTexture(device,b);if(c)SDL_ReleaseGPUTexture(device,c);return false;}
+    if(movie_blur_input)SDL_ReleaseGPUTexture(device,movie_blur_input);if(movie_blur_temp)SDL_ReleaseGPUTexture(device,movie_blur_temp);if(movie_blur_output)SDL_ReleaseGPUTexture(device,movie_blur_output);
+    movie_blur_input=a;movie_blur_temp=b;movie_blur_output=c;movie_blur_w=w;movie_blur_h=h;return true;
+}
+static bool MovieBlurPass(SDL_GPUCommandBuffer *cmd,SDL_GPUTexture *src,SDL_GPUTexture *dst,float x,float y,float dim){
+    SDL_GPUColorTargetInfo target={0};target.texture=dst;target.load_op=SDL_GPU_LOADOP_DONT_CARE;target.store_op=SDL_GPU_STOREOP_STORE;target.cycle=true;
+    SDL_GPURenderPass *pass=SDL_BeginGPURenderPass(cmd,&target,1,NULL);if(!pass)return false;
+    SDL_BindGPUGraphicsPipeline(pass,movie_blur_pipeline);SDL_GPUTextureSamplerBinding binding={src,movie_blur_sampler};SDL_BindGPUFragmentSamplers(pass,0,&binding,1);float u[4]={x,y,dim,0};SDL_PushGPUFragmentUniformData(cmd,0,u,sizeof(u));SDL_DrawGPUPrimitives(pass,3,1,0,0);SDL_EndGPURenderPass(pass);return true;
+}
+static bool MovieBlurPresent(SDL_GPUCommandBuffer *cmd,SDL_GPUBlitRegion src,SDL_GPUTexture *swapchain,WndSize win,SDL_Rect center,bool rgb24){
+    if(!movie_blur_requested||!rgb24||!src.texture||!src.w||!src.h||win.w<=0||win.h<=0||(center.x==0&&center.y==0&&center.w==win.w&&center.h==win.h)){MovieBlurLog(0);return false;}
+    if(movie_blur_failed){MovieBlurLog(2);return false;}
+    float ratio=SDL_min(1.f,256.f/(float)SDL_max(src.w,src.h));Uint32 w=SDL_max(1u,(Uint32)((float)src.w*ratio)),h=SDL_max(1u,(Uint32)((float)src.h*ratio));
+    if(!MovieBlurPrepare(w,h))goto failed;
+    SDL_GPUBlitInfo compact={0};compact.source=src;compact.destination.texture=movie_blur_input;compact.destination.w=w;compact.destination.h=h;compact.filter=SDL_GPU_FILTER_LINEAR;compact.load_op=SDL_GPU_LOADOP_DONT_CARE;compact.cycle=true;SDL_BlitGPUTexture(cmd,&compact);
+    if(!MovieBlurPass(cmd,movie_blur_input,movie_blur_temp,1.f/(float)w,0,1)||!MovieBlurPass(cmd,movie_blur_temp,movie_blur_output,0,1.f/(float)h,.65f))goto failed;
+    SDL_GPUBlitInfo background={0};background.source.texture=movie_blur_output;background.source.w=w;background.source.h=h;
+    if((uint64_t)w*(Uint32)win.h>(uint64_t)h*(Uint32)win.w){background.source.w=SDL_max(1u,(Uint32)((uint64_t)h*(Uint32)win.w/(Uint32)win.h));background.source.x=(w-background.source.w)/2;}
+    else {background.source.h=SDL_max(1u,(Uint32)((uint64_t)w*(Uint32)win.h/(Uint32)win.w));background.source.y=(h-background.source.h)/2;}
+    background.destination.texture=swapchain;background.destination.w=(Uint32)win.w;background.destination.h=(Uint32)win.h;background.load_op=SDL_GPU_LOADOP_CLEAR;background.clear_color=(SDL_FColor){0,0,0,1};background.filter=SDL_GPU_FILTER_LINEAR;SDL_BlitGPUTexture(cmd,&background);MovieBlurLog(1);return true;
+failed:movie_blur_failed=1;WARNF("Movie backdrop fallback: %s",SDL_GetError());MovieBlurLog(2);return false;
+}
diff --git a/psyz/src/platform/pe-ps5-render-buffer.h b/psyz/src/platform/pe-ps5-render-buffer.h
new file mode 100644
index 0000000..a22fd0c
--- /dev/null
+++ b/psyz/src/platform/pe-ps5-render-buffer.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef PE_PS5_RENDER_BUFFER_H
+#define PE_PS5_RENDER_BUFFER_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+#ifdef PE_PS5
+extern int sceKernelAllocateMainDirectMemory(size_t,size_t,int,intptr_t*);
+extern int sceKernelMapDirectMemory(void**,size_t,int,int,intptr_t,size_t);
+extern int sceKernelReleaseDirectMemory(intptr_t,size_t);
+extern int sceKernelMunmap(void*,size_t);
+typedef struct {void *data;size_t bytes;intptr_t physical;bool allocated;} PeRenderBuffer;
+static void PeRenderError(const char *stage,int error,size_t bytes){
+ static unsigned reports;
+ if(reports++<16)ERRORF("PS5 geometry direct memory %s failed code=0x%x bytes=%zu",stage,(unsigned)error,bytes);
+}
+static bool PeRenderRelease(PeRenderBuffer *b){
+ if(b->data){int r=sceKernelMunmap(b->data,b->bytes);if(r){PeRenderError("unmap",r,b->bytes);return false;}b->data=NULL;}
+ if(b->allocated){int r=sceKernelReleaseDirectMemory(b->physical,b->bytes);if(r){PeRenderError("release",r,b->bytes);return false;}b->allocated=false;}
+ b->bytes=0;b->physical=0;return true;
+}
+/* Fixed bounded arenas, allocated once on first use. Never grow or replace a
+ * live mapping. A failed cleanup retains its handle for teardown retry. */
+static bool PeRenderReserve(PeRenderBuffer *b,size_t bytes){
+ const size_t align=0x20000,limit=24u*1024u*1024u;
+ if(!bytes || bytes>limit)return false;
+ if(b->data)return b->bytes>=bytes;
+ if(b->allocated)return false;
+ bytes=(bytes+align-1)&~(align-1);
+ intptr_t physical=0;
+ int r=sceKernelAllocateMainDirectMemory(bytes,align,3,&physical);
+ if(r){PeRenderError("allocate",r,bytes);return false;}
+ b->physical=physical;b->bytes=bytes;b->allocated=true;
+ void *mapped=NULL;r=sceKernelMapDirectMemory(&mapped,bytes,0x33,0,physical,align);
+ if(r || !mapped){PeRenderError("map",r?r:-1,bytes);PeRenderRelease(b);return false;}
+ b->data=mapped;INFOF("PS5 geometry direct memory ready bytes=%zu",bytes);return true;
+}
+#endif
+#endif
diff --git a/psyz/src/platform/present_fsr1.h b/psyz/src/platform/present_fsr1.h
new file mode 100644
index 0000000..b5231dc
--- /dev/null
+++ b/psyz/src/platform/present_fsr1.h
@@ -0,0 +1,67 @@
+// Native-only optional presentation adapter. Included after PsyZ device state.
+#include "fsr1/cpe_fsr1.h"
+static CpeFsr1 *fsr1_state;
+static SDL_GPUTexture *fsr1_input;
+static Uint32 fsr1_iw,fsr1_ih;
+static int fsr1_requested,fsr1_sharpness=1,fsr1_failed,fsr1_effective;
+static unsigned fsr1_log_count;
+static char fsr1_last_status[192];
+void Psyz_VideoSetFsr1(int enabled,int sharpness) {
+    enabled=enabled!=0;sharpness=SDL_clamp(sharpness,0,2);
+    if(enabled!=fsr1_requested||sharpness!=fsr1_sharpness) {
+        fsr1_failed=0;fsr1_last_status[0]=0;
+        INFOF("FSR1 setting requested=%d sharpness_stops=%d (0 strongest,2 soft)",enabled,sharpness);
+    }
+    fsr1_requested=enabled;fsr1_sharpness=sharpness;
+    if(!enabled)fsr1_effective=0;
+}
+int Psyz_VideoGetFsr1Status(void){return fsr1_effective;}
+static void Fsr1Status(const char *status,SDL_GPUBlitRegion src,SDL_Rect dst) {
+    fsr1_effective=!fsr1_requested?0:!SDL_strcmp(status,"EASU+RCAS-recorded")?2:fsr1_failed?3:1;
+    char message[192];SDL_snprintf(message,sizeof(message),"requested=%d effective=%s input=%ux%u output=%dx%d sharpness_stops=%d stage=%s bars=aspect-policy",fsr1_requested,status,src.w,src.h,dst.w,dst.h,fsr1_sharpness,display_rgb24?"RGB24-movie-or-still":"game-image");
+    if(SDL_strcmp(message,fsr1_last_status)&&fsr1_log_count<32){
+        INFOF("FSR1 %s rendered_output=unobserved",message);fsr1_log_count++;
+        SDL_strlcpy(fsr1_last_status,message,sizeof(fsr1_last_status));
+    }
+}
+static SDL_GPUBlitRegion Fsr1Present(SDL_GPUCommandBuffer *cmd,SDL_GPUBlitRegion src,SDL_Rect dst) {
+    if(!fsr1_requested){Fsr1Status("off",src,dst);return src;}
+    if(dst.w<=0||dst.h<=0||!src.w||!src.h){Fsr1Status("original-invalid-extent",src,dst);return src;}
+    if(src.w>(Uint32)dst.w||src.h>(Uint32)dst.h){Fsr1Status("original-downscale",src,dst);return src;}
+    if(src.w>8192||src.h>8192||dst.w>8192||dst.h>8192||
+       (uint64_t)src.w*src.h*4+(uint64_t)dst.w*dst.h*16>160u*1024u*1024u){
+        Fsr1Status("original-budget",src,dst);return src;
+    }
+    if(fsr1_failed){Fsr1Status("original-error-latched",src,dst);return src;}
+    if(!fsr1_state){
+        fsr1_state=CpeFsr1_Create(device);
+        if(!fsr1_state){WARNF("FSR1 optional pipeline unavailable: %s",SDL_GetError());fsr1_failed=1;Fsr1Status("original-pipeline-failed",src,dst);return src;}
+        CpeFsr1_SetEnabled(fsr1_state,true);
+    }
+    if(!fsr1_input||fsr1_iw!=src.w||fsr1_ih!=src.h){
+        SDL_GPUTextureCreateInfo t={0};t.type=SDL_GPU_TEXTURETYPE_2D;
+        t.format=SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+        t.usage=SDL_GPU_TEXTUREUSAGE_SAMPLER|SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+        t.width=src.w;t.height=src.h;t.layer_count_or_depth=1;t.num_levels=1;t.sample_count=SDL_GPU_SAMPLECOUNT_1;
+        SDL_GPUTexture *replacement=SDL_CreateGPUTexture(device,&t);
+        if(!replacement){WARNF("FSR1 compact image allocation failed: %s",SDL_GetError());fsr1_failed=1;Fsr1Status("original-input-allocation-failed",src,dst);return src;}
+        if(fsr1_input)SDL_ReleaseGPUTexture(device,fsr1_input);
+        fsr1_input=replacement;fsr1_iw=src.w;fsr1_ih=src.h;
+    }
+    // Crop BEFORE gathering. A clamp sampler on the full VRAM texture would
+    // still let EASU tap other pages outside the selected game rectangle.
+    SDL_GPUBlitInfo crop={0};crop.source=src;
+    crop.destination=(SDL_GPUBlitRegion){.texture=fsr1_input,.w=src.w,.h=src.h};
+    crop.load_op=SDL_GPU_LOADOP_DONT_CARE;crop.filter=SDL_GPU_FILTER_NEAREST;crop.cycle=true;
+    SDL_BlitGPUTexture(cmd,&crop);
+    SDL_GPUTexture *filtered=CpeFsr1_Record(fsr1_state,cmd,fsr1_input,src.w,src.h,(Uint32)dst.w,(Uint32)dst.h,(float)fsr1_sharpness);
+    if(!filtered){WARNF("FSR1 optional pass failed: %s",SDL_GetError());fsr1_failed=1;Fsr1Status("original-filter-failed",src,dst);return src;}
+    Fsr1Status("EASU+RCAS-recorded",src,dst);
+    return (SDL_GPUBlitRegion){.texture=filtered,.w=(Uint32)dst.w,.h=(Uint32)dst.h};
+}
+static void Fsr1Destroy(void) {
+    // Caller only reaches this after the existing GPU retirement succeeds.
+    if(fsr1_input)SDL_ReleaseGPUTexture(device,fsr1_input);
+    fsr1_input=NULL;fsr1_iw=fsr1_ih=0;
+    CpeFsr1_Destroy(fsr1_state);fsr1_state=NULL;fsr1_failed=0;
+}
