diff --git a/psyz/src/platform/committed_presentation.h b/psyz/src/platform/committed_presentation.h
new file mode 100644
index 0000000..ea10568
--- /dev/null
+++ b/psyz/src/platform/committed_presentation.h
@@ -0,0 +1,65 @@
+/* Original project per-raster contract. Requested settings configure future
+ * draws; already drawn VRAM must retain the projection that created it. */
+typedef struct {
+    bool valid,wide,pal;
+    int x,y,w,h,horiz,vert;
+    PsyzAspectMode aspect;
+    unsigned long long serial;
+    unsigned char picture[sizeof(ws_picture)];
+    unsigned char room[sizeof(resolution_room)];
+} CommittedPresentation;
+typedef struct {
+    bool active,wide,pal;
+    int horiz,vert;
+    PsyzAspectMode aspect;
+    unsigned char picture[sizeof(ws_picture)];
+    unsigned char room[sizeof(resolution_room)];
+} PresentationScope;
+static CommittedPresentation committed_presentation[2];
+static unsigned long long committed_draw_serial;
+static unsigned committed_log_count;
+static int committed_last_pending=-1,committed_last_wide=-1,committed_last_aspect=-1;
+static int committed_last_requested_wide=-1,committed_last_requested_aspect=-1;
+
+/* Called after actual nonempty display-buffer draw commands are recorded,
+ * never from the host modal/UI presentation loop. */
+static void CommitDrawPresentation(void){
+    if(!DisplayBufferDraw())return;
+    int y=(draw_area_start.y/display_size.y)*display_size.y;
+    int slot=-1;for(int i=0;i<2;i++)if(committed_presentation[i].valid&&committed_presentation[i].y==y)slot=i;
+    if(slot<0)for(int i=0;i<2;i++)if(!committed_presentation[i].valid){slot=i;break;}
+    if(slot<0)slot=committed_presentation[0].serial<committed_presentation[1].serial?0:1;
+    CommittedPresentation *f=&committed_presentation[slot];
+    f->valid=true;f->wide=widescreen;f->aspect=aspect_mode;f->pal=is_pal;
+    f->x=display_area.x;f->y=y;f->w=display_size.x;f->h=display_size.y;
+    f->horiz=set_disp_horiz;f->vert=set_disp_vert;f->serial=++committed_draw_serial;
+    memcpy(f->picture,ws_picture,sizeof(ws_picture));
+    memcpy(f->room,resolution_room,sizeof(resolution_room));
+}
+static PresentationScope BeginCommittedPresentation(bool game_image){
+    PresentationScope scope={0};if(!game_image)return scope;
+    CommittedPresentation *f=NULL;
+    for(int i=0;i<2;i++){CommittedPresentation *candidate=&committed_presentation[i];
+        if(candidate->valid&&candidate->x==display_area.x&&candidate->y==display_area.y&&
+           candidate->w==display_size.x&&candidate->h==display_size.y)f=candidate;}
+    if(!f)return scope; /* No matching raster yet: retain baseline startup path. */
+    int pending=f->wide!=widescreen||f->aspect!=aspect_mode;
+    if(committed_log_count<64&&(pending!=committed_last_pending||f->wide!=committed_last_wide||
+        f->aspect!=committed_last_aspect||widescreen!=committed_last_requested_wide||aspect_mode!=committed_last_requested_aspect)){
+        INFOF("DISPLAY committed-raster requested_wide=%d requested_aspect=%d raster_wide=%d raster_aspect=%d pending_new_game_draw=%d buffer=%d,%d/%dx%d draw_serial=%llu mode=game-image not_stretch=1 rendered=unobserved",widescreen,aspect_mode,f->wide,f->aspect,pending,f->x,f->y,f->w,f->h,f->serial);
+        committed_log_count++;committed_last_pending=pending;committed_last_wide=f->wide;committed_last_aspect=f->aspect;
+        committed_last_requested_wide=widescreen;committed_last_requested_aspect=aspect_mode;
+    }
+    scope.active=true;scope.wide=widescreen;scope.aspect=aspect_mode;scope.pal=is_pal;
+    scope.horiz=set_disp_horiz;scope.vert=set_disp_vert;
+    memcpy(scope.picture,ws_picture,sizeof(ws_picture));memcpy(scope.room,resolution_room,sizeof(resolution_room));
+    widescreen=f->wide;aspect_mode=f->aspect;is_pal=f->pal;set_disp_horiz=f->horiz;set_disp_vert=f->vert;
+    memcpy(ws_picture,f->picture,sizeof(ws_picture));memcpy(resolution_room,f->room,sizeof(resolution_room));
+    return scope;
+}
+static void EndCommittedPresentation(const PresentationScope *scope){
+    if(!scope->active)return;
+    widescreen=scope->wide;aspect_mode=scope->aspect;is_pal=scope->pal;
+    set_disp_horiz=scope->horiz;set_disp_vert=scope->vert;
+    memcpy(ws_picture,scope->picture,sizeof(ws_picture));memcpy(resolution_room,scope->room,sizeof(resolution_room));
+}
diff --git a/psyz/src/platform/cpu-material-adapter.h b/psyz/src/platform/cpu-material-adapter.h
new file mode 100644
index 0000000..cc68022
--- /dev/null
+++ b/psyz/src/platform/cpu-material-adapter.h
@@ -0,0 +1,260 @@
+/* CPU native-pack material adapter experiment.
+ * Original implementation for this integration; no emulator implementation.
+ * Included by sdl3_gpu.c after LoadHdImage so existing WebP/PNG decoding is reused.
+ * Ordered presentation consumer; canonical VRAM remains authoritative.
+ */
+#ifndef PE_CPU_MATERIAL_ADAPTER_H
+#define PE_CPU_MATERIAL_ADAPTER_H
+#define CPU_MATERIAL_SLOTS 32
+#define CPU_MATERIAL_FAILED_SLOTS 256
+#define CPU_MATERIAL_BUDGET (16u*1024u*1024u)
+typedef struct {
+    uint64_t key;
+    SDL_Surface *art, *reference;
+    unsigned columns, rows;
+    size_t bytes;
+} CpuMaterialAtlas;
+typedef struct {
+    const CpuMaterialAtlas *atlas;
+    unsigned cell;
+    bool extension;
+} CpuMaterialSelection;
+static CpuMaterialAtlas cpu_material_cache[CPU_MATERIAL_SLOTS];
+static unsigned cpu_material_count;
+/* Current configured root/reset epoch only. Fixed FIFO; failed entries own no
+ * surfaces and never evict successful atlases or disturb held selections.
+ * All failures, including allocator/decoder OOM, retry after OFF->ON, explicit
+ * atlas reset, root change, or FIFO eviction. No file polling/mtime promise. */
+static uint64_t cpu_material_failed_keys[CPU_MATERIAL_FAILED_SLOTS];
+static unsigned cpu_material_failed_count,cpu_material_failed_next;
+static size_t cpu_material_bytes;
+static CpuMaterialSelection cpu_material_next;
+
+static int cpu_material_requested;
+static char cpu_material_directory[4096];
+static uint64_t cm_hits,cm_misses,cm_loaded,cm_failed,cm_unsupported,cm_failed_hits;
+static uint64_t cm_selected,cm_select_miss,cm_samples,cm_rejected,cm_present,cm_fallback;
+static unsigned cm_logs;
+static Uint64 cm_last_log;
+static void CmCount(uint64_t *n) { if(*n!=UINT64_MAX)++*n; }
+static int CpuMaterialRememberFailure(uint64_t key) {
+    cpu_material_failed_keys[cpu_material_failed_next]=key;
+    if(cpu_material_failed_count<CPU_MATERIAL_FAILED_SLOTS)++cpu_material_failed_count;
+    if(++cpu_material_failed_next==CPU_MATERIAL_FAILED_SLOTS)cpu_material_failed_next=0;
+    CmCount(&cm_failed);return -1;
+}
+int Psyz_CpuFieldMaterialAvailable(void) {
+#ifdef PE_PS5
+    return ps5_interactive_software && sdl3_window && is_platform_init_successful;
+#else
+    return 0;
+#endif
+}
+static bool CpuMaterialEnabled(void) {
+#ifdef PE_PS5
+    return cpu_material_requested && *cpu_material_directory && Psyz_CpuFieldMaterialAvailable();
+#else
+    return false;
+#endif
+}
+static void CpuMaterialSummary(int force) {
+    Uint64 now=SDL_GetTicks();
+    if((!force && (now-cm_last_log<10000)))return;
+    cm_last_log=now;++cm_logs;
+    unsigned long long covered=0,total=0;
+    SoftwareRasterizer_MaterialCoverage(&covered,&total);
+    INFOF("CPU fieldHD requested=%d available=%d eligible=%d cache=%u bytes=%zu failed_keys=%u failed_hit=%llu hit=%llu miss=%llu loaded=%llu failed=%llu unsupported=%llu selected=%llu select_miss=%llu sampled=%llu rejected=%llu ordered_HD_writes=%llu/textured_sprite_samples=%llu prepared_HD=%llu fallback=%llu (ordered accepted HD samples/textured sprite samples this epoch; cache counters cumulative)",
+        cpu_material_requested,Psyz_CpuFieldMaterialAvailable(),CpuMaterialEnabled(),cpu_material_count,cpu_material_bytes,
+        cpu_material_failed_count,(unsigned long long)cm_failed_hits,
+        (unsigned long long)cm_hits,(unsigned long long)cm_misses,(unsigned long long)cm_loaded,(unsigned long long)cm_failed,
+        (unsigned long long)cm_unsupported,(unsigned long long)cm_selected,(unsigned long long)cm_select_miss,
+        (unsigned long long)cm_samples,(unsigned long long)cm_rejected,covered,total,
+        (unsigned long long)cm_present,(unsigned long long)cm_fallback);
+}
+static void CpuMaterialReset(void) {
+    CpuMaterialSummary(1);
+    SoftwareRasterizer_Reject2x();
+    SoftwareRasterizer_InvalidateMaterial();
+    SoftwareRasterizer_SetMaterialSampler(NULL);
+    cpu_material_next=(CpuMaterialSelection){0};
+    for(unsigned i=0;i<cpu_material_count;++i) {
+        SDL_DestroySurface(cpu_material_cache[i].art);
+        SDL_DestroySurface(cpu_material_cache[i].reference);
+    }
+    memset(cpu_material_cache,0,sizeof(cpu_material_cache));
+    cpu_material_count=0;cpu_material_bytes=0;
+    memset(cpu_material_failed_keys,0,sizeof(cpu_material_failed_keys));
+    cpu_material_failed_count=0;cpu_material_failed_next=0;
+}
+int Psyz_CpuFieldMaterialConfigure(int enabled,const char *directory) {
+    if(!directory)directory="";
+    size_t n=strlen(directory);
+    int valid=n<sizeof(cpu_material_directory) && (!n || (directory[0]=='/' &&
+        !strstr(directory,"/../") && !strstr(directory,"/./") && !strchr(directory,'\\') &&
+        !(n>=3 && !strcmp(directory+n-3,"/..")) && !(n>=2 && !strcmp(directory+n-2,"/."))));
+    if(!valid){enabled=0;directory="";}
+    enabled=enabled!=0;
+    if(cpu_material_requested!=enabled || strcmp(cpu_material_directory,directory)) {
+        CpuMaterialReset();
+        cpu_material_requested=enabled;SDL_strlcpy(cpu_material_directory,directory,sizeof(cpu_material_directory));
+        CpuMaterialSummary(1);
+    }
+    return CpuMaterialEnabled(); /* Actual current capability, never asset-success. */
+}
+const char *Psyz_CpuFieldMaterialDirectory(void) { return CpuMaterialEnabled()?cpu_material_directory:""; }
+static bool CpuMaterialShape(SDL_Surface *s) {
+    return s && s->w>0 && s->h>0 && s->w<=16*68 && s->h<=8192 &&
+        s->w%68==0 && s->h%68==0 &&
+        (uint64_t)s->w*s->h*8<=CPU_MATERIAL_BUDGET;
+}
+static int CpuMaterialLoad(uint64_t key,const char *filename) {
+    if(!CpuMaterialEnabled() || !key || !filename) return 0;
+    /* Only official separate-reference WebP layout in this bounded adapter.
+     * Combined PNG/BMP and extension cells explicitly remain unsupported. */
+    const char *ext=SDL_strrchr(filename,'.');
+    if(!ext || SDL_strcasecmp(ext,".webp")){CmCount(&cm_unsupported);return 0;}
+    /* The producer emits root/key.webp. Validate the actual pathname before
+     * consulting either key cache: a stale producer root must not poison the
+     * new configuration or falsely hit an atlas from it. Reset clears the
+     * entire epoch, so generation counters cannot wrap into stale entries. */
+    char expected[4096];
+    int length=SDL_snprintf(expected,sizeof(expected),"%s/%016llx.webp",
+        cpu_material_directory,(unsigned long long)key);
+    if(length<0 || (size_t)length>=sizeof(expected) || strcmp(filename,expected))return 0;
+    for(unsigned i=0;i<cpu_material_count;++i)
+        if(cpu_material_cache[i].key==key){CmCount(&cm_hits);return 1;}
+    for(unsigned i=0;i<cpu_material_failed_count;++i)
+        if(cpu_material_failed_keys[i]==key){CmCount(&cm_failed_hits);return -1;}
+    CmCount(&cm_misses);
+    if(cpu_material_count==CPU_MATERIAL_SLOTS)return CpuMaterialRememberFailure(key);
+    char path[4096];size_t prefix=(size_t)(ext-filename);
+    if(prefix+sizeof(".ref.png")>sizeof(path))return CpuMaterialRememberFailure(key);
+    memcpy(path,filename,prefix);memcpy(path+prefix,".ref.png",sizeof(".ref.png"));
+    /* Keep both streams stable through metadata validation and decode. Never
+     * use LoadHdImage here: its title/GPU allocation cap is intentionally larger.
+     * No eviction: selections carry atlas pointers until reset invalidates them. */
+    SDL_Surface *art=NULL,*reference=NULL,*converted=NULL;
+    SDL_IOStream *webp=NULL,*pngfile=NULL;
+    void *data=NULL;
+    webp=SDL_IOFromFile(filename,"rb");pngfile=SDL_IOFromFile(path,"rb");
+    if(!webp || !pngfile)goto fail;
+    Sint64 compressed=SDL_GetIOSize(webp),pngsize=SDL_GetIOSize(pngfile);
+    if(compressed<=0 || compressed>32*1024*1024 || pngsize<33 ||
+       pngsize>32*1024*1024)goto fail;
+    /* Compressed input is separately capped; only decoded surface storage is
+     * charged to CPU_MATERIAL_BUDGET, not libwebp's internal scratch memory. */
+    data=SDL_malloc((size_t)compressed);
+    if(!data || SDL_ReadIO(webp,data,(size_t)compressed)!=(size_t)compressed)goto fail;
+    WebPBitstreamFeatures features;
+    if(WebPGetFeatures(data,(size_t)compressed,&features)!=VP8_STATUS_OK ||
+       features.has_animation || features.width<=0 || features.height<=0 ||
+       features.width>16*68 || features.height>8192 ||
+       features.width%68 || features.height%68)goto fail;
+    unsigned char png[33];
+    static const unsigned char signature[16]={
+        137,80,78,71,13,10,26,10,0,0,0,13,73,72,68,82};
+    if(SDL_ReadIO(pngfile,png,sizeof(png))!=sizeof(png) ||
+       memcmp(png,signature,sizeof(signature)))goto fail;
+    uint32_t pw=((uint32_t)png[16]<<24)|((uint32_t)png[17]<<16)|
+        ((uint32_t)png[18]<<8)|png[19];
+    uint32_t ph=((uint32_t)png[20]<<24)|((uint32_t)png[21]<<16)|
+        ((uint32_t)png[22]<<8)|png[23];
+    if(pw!=(unsigned)features.width || ph!=(unsigned)features.height ||
+       png[26] || png[27] || png[28]>1)goto fail;
+    /* Valid PNG sample layouts only. SDL's decoder may expand 16-bit RGBA
+     * to eight bytes/pixel before RGBA32 conversion; reserve that peak too. */
+    unsigned depth=png[24],color=png[25];
+    if(!((color==0 && (depth==1||depth==2||depth==4||depth==8||depth==16)) ||
+         (color==3 && (depth==1||depth==2||depth==4||depth==8)) ||
+         ((color==2||color==4||color==6) && (depth==8||depth==16))))goto fail;
+    uint64_t pixels=(uint64_t)pw*ph;
+    if(cpu_material_bytes>CPU_MATERIAL_BUDGET ||
+       pixels>(CPU_MATERIAL_BUDGET-cpu_material_bytes)/16u)goto fail;
+    if(SDL_SeekIO(pngfile,0,SDL_IO_SEEK_SET)!=0)goto fail;
+    art=SDL_CreateSurface(features.width,features.height,SDL_PIXELFORMAT_RGBA32);
+    if(!art || art->pitch!=features.width*4 ||
+       !WebPDecodeRGBAInto(data,(size_t)compressed,art->pixels,
+           (size_t)art->pitch*art->h,art->pitch))goto fail;
+    SDL_free(data);data=NULL;
+    reference=SDL_LoadPNG_IO(pngfile,false);
+    if(!CpuMaterialShape(reference) || reference->w!=art->w || reference->h!=art->h)goto fail;
+    if(reference->format!=SDL_PIXELFORMAT_RGBA32) {
+        converted=SDL_ConvertSurface(reference,SDL_PIXELFORMAT_RGBA32);
+        if(!converted)goto fail;
+        SDL_DestroySurface(reference);reference=converted;converted=NULL;
+    }
+    if(reference->pitch!=reference->w*4 || art->pitch<=0 || reference->pitch<=0)goto fail;
+    size_t bytes=((size_t)art->pitch+(size_t)reference->pitch)*(size_t)art->h;
+    if(bytes>CPU_MATERIAL_BUDGET-cpu_material_bytes)goto fail;
+    SDL_CloseIO(webp);SDL_CloseIO(pngfile);
+    /* Publish only a complete pair. Every earlier failure leaves accounting
+     * and all existing selections untouched, and retains canonical fallback. */
+    cpu_material_cache[cpu_material_count++]=(CpuMaterialAtlas){
+        key,art,reference,(unsigned)art->w/68,(unsigned)art->h/68,bytes};
+    cpu_material_bytes+=bytes;CmCount(&cm_loaded);
+    return 1;
+fail:
+    if(webp)SDL_CloseIO(webp);
+    if(pngfile)SDL_CloseIO(pngfile);
+    SDL_free(data);SDL_DestroySurface(converted);
+    SDL_DestroySurface(art);SDL_DestroySurface(reference);return CpuMaterialRememberFailure(key);
+}
+static void CpuMaterialSelect(uint64_t key,unsigned cell) {
+    cpu_material_next=(CpuMaterialSelection){0};
+    if(!CpuMaterialEnabled())return;
+    bool extension=(cell&0x800000u)!=0;cell&=0x7fffffu;
+    for(unsigned i=0;i<cpu_material_count;++i) {
+        CpuMaterialAtlas *a=&cpu_material_cache[i];
+        if(a->key==key && cell<a->columns*a->rows) {
+            cpu_material_next=(CpuMaterialSelection){a,cell,extension};CmCount(&cm_selected);return;
+        }
+    }
+    CmCount(&cm_select_miss);
+}
+/* One selection belongs to the immediately following primitive, never UI later.
+ * The draw backend will consume this at Draw_PushPrim entry, before decoding. */
+static CpuMaterialSelection CpuMaterialTake(void) {
+    CpuMaterialSelection result=cpu_material_next;
+    cpu_material_next=(CpuMaterialSelection){0};
+    return CpuMaterialEnabled()?result:(CpuMaterialSelection){0};
+}
+/* Pure consumer: caller must prove native accepted coverage first. All four
+ * samples commit atomically. Refplanes identify unchanged palette pixels; they
+ * do not confer PS1 coverage, depth, transparency or mask ownership. */
+static bool CpuMaterialSample2x(CpuMaterialSelection selection,unsigned px,
+    unsigned py,uint16_t native,uint16_t output[4]) {
+    const CpuMaterialAtlas *a=selection.atlas;
+    if(!a)return false;
+    CmCount(&cm_samples);
+    uint16_t staged[4];
+    if(!a || !output || px>=16 || py>=16 || !native ||
+        !a->columns || selection.cell>=a->columns*a->rows){CmCount(&cm_rejected);return false;}
+    unsigned left=(selection.cell%a->columns)*68+2;
+    unsigned top=(selection.cell/a->columns)*68+2;
+    for(unsigned sy=0;sy<2;++sy)for(unsigned sx=0;sx<2;++sx) {
+        unsigned x=left+px*4+sx*2+1,y=top+py*4+sy*2+1;
+        const uint8_t *ref=(const uint8_t *)a->reference->pixels+
+            (size_t)y*a->reference->pitch+(size_t)x*4;
+        const uint8_t *art=(const uint8_t *)a->art->pixels+
+            (size_t)y*a->art->pitch+(size_t)x*4;
+        unsigned basis=(ref[0]>>3)|((ref[1]>>3)<<5)|((ref[2]>>3)<<10);
+        if(ref[3]!=255 || art[3]!=255 || basis!=(native&0x7fff)){CmCount(&cm_rejected);return false;}
+        staged[sy*2+sx]=(uint16_t)((art[0]>>3)|((art[1]>>3)<<5)|((art[2]>>3)<<10));
+    }
+    memcpy(output,staged,sizeof(staged));return true;
+}
+/* Extension art owns only noncanonical pixels. No reference comparison can
+ * manufacture native coverage: absent/transparent texels simply draw nothing. */
+static int CpuExtensionSample(unsigned px,unsigned py,unsigned lx,unsigned ly,
+    unsigned scale,uint16_t *out) {
+ const CpuMaterialSelection s=cpu_material_next;const CpuMaterialAtlas *a=s.atlas;
+ if(!CpuMaterialEnabled() || !s.extension || !a || !out || px>=16 || py>=16 ||
+    !scale || lx>=scale || ly>=scale || s.cell>=a->columns*a->rows)return 0;
+ unsigned x=(s.cell%a->columns)*68+2+px*4+(4*lx+2)/scale;
+ unsigned y=(s.cell/a->columns)*68+2+py*4+(4*ly+2)/scale;
+ if(x>=(unsigned)a->art->w || y>=(unsigned)a->art->h)return 0;
+ const uint8_t *v=(const uint8_t*)a->art->pixels+(size_t)y*a->art->pitch+x*4;
+ if(v[3]!=255)return 0;
+ *out=(uint16_t)((v[0]>>3)|((v[1]>>3)<<5)|((v[2]>>3)<<10));return 1;
+}
+#endif
diff --git a/psyz/src/platform/cpu-raster2x.h b/psyz/src/platform/cpu-raster2x.h
new file mode 100644
index 0000000..60de28b
--- /dev/null
+++ b/psyz/src/platform/cpu-raster2x.h
@@ -0,0 +1,272 @@
+/* SPDX-License-Identifier: MIT
+ * Bounded variable-scale CPU triangle component (1 native; 2/4/6/8 experimental). No canonical VRAM writes or feedback.
+ * Caller seeds a presentation epoch from canonical display-page RGB555.
+ * Unsupported operation poisons the WHOLE epoch until next explicit begin.
+ * Configuration and presentation are owned by the caller. */
+#ifndef PE_CPU_2X_H
+#define PE_CPU_2X_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include "pe-ps5-render-buffer.h"
+#include <stdlib.h>
+#include <limits.h>
+#define PE2_MAX_SCALE 8
+#define PE2_MAX_PIXELS ((size_t)320*240*PE2_MAX_SCALE*PE2_MAX_SCALE)
+static bool Pe2PageValid(int x,int y,int w,int h){
+ return x>=0 && y>=0 && w>0 && h>0 && w<=320 && h<=240 && x<=1024-w && y<=512-h;
+}
+enum {PE2_UNSUPPORTED=1,PE2_BOUNDS,PE2_ALLOC,PE2_PAGE,PE2_CONFIG,PE2_RGB24,PE2_EMPTY,PE2_REASON_COUNT};
+static bool Pe2ScaleValid(int s){return s==1 || s==2 || s==4 || s==6 || s==8;}
+_Static_assert(320*8*3 <= INT_MAX && 240*8 <= INT_MAX,"RGB pitch/dimensions");
+_Static_assert(PE2_MAX_PIXELS <= SIZE_MAX/3,"allocation arithmetic");
+_Static_assert(INT64_C(255)*4095*4096*2*16*8192*2 < INT64_MAX,"attribute intermediates");
+/* Floor, including negative attribute planes; preserves native 8-bit wrap. */
+static int Pe2Attribute(int64_t n,int d){
+ int64_t q=n/d;if(n<0 && n%d)--q;return (int)((uint64_t)q&255);
+}
+typedef struct {int x,y,u,v,r,g,b;} Pe2Vertex;
+#ifndef PE2_SAMPLE_VISIBLE
+#define PE2_SAMPLE_VISIBLE(value) ((value)!=0)
+#endif
+typedef uint16_t (*Pe2Sample)(void *,int,int,int,int,int);
+#ifndef PE2_MATERIAL_USED
+#define PE2_MATERIAL_USED false
+#endif
+typedef uint16_t (*Pe2PolygonSample)(void *,int,int,int,int,int,int,int);
+/* Per-primitive state is captured before canonical rasterization. Destination
+ * words retain RGB555 and bit15 independently at every high-resolution sample. */
+typedef struct {
+ bool semi,set_mask,preserve_mask;
+ int abr;
+ bool (*write)(uint16_t *,uint16_t,bool,int,bool,bool);
+} Pe2Paint;
+static bool Pe2Write(Pe2Paint paint,uint16_t *out,uint16_t src,bool textured) {
+ return paint.write(out,src,paint.semi && (!textured || (src&0x8000)),
+                    paint.abr,paint.set_mask,paint.preserve_mask);
+}
+typedef struct {
+ uint16_t *pixels;
+#ifdef PE_PS5
+ PeRenderBuffer direct;
+#endif
+ size_t capacity;
+ unsigned long long material_covered,material_total;
+ int scale,reason;
+ int w,h,page_x,page_y,sx0,sy0,sx1,sy1;
+ bool active,failed,drawn;
+} Pe2Frame;
+static void Pe2RejectReason(Pe2Frame *f,int reason){
+ if(f && f->active){if(!f->failed)f->reason=reason;f->failed=true;}
+}
+__attribute__((used,retain)) void Pe2Reject(Pe2Frame *f){Pe2RejectReason(f,PE2_UNSUPPORTED);}
+/* Bounds and page identity are explicit. No backing pointer escapes. */
+__attribute__((used,retain)) bool Pe2Begin(Pe2Frame *f,int scale,const uint16_t *native,int pitch,
+ int x,int y,int w,int h) {
+ if(!f)return false;
+ f->active=false;f->failed=false;f->drawn=false;f->reason=0;f->scale=scale;
+ f->material_covered=f->material_total=0;
+ if(!Pe2ScaleValid(scale) || !native || pitch!=1024 || !Pe2PageValid(x,y,w,h)){f->reason=PE2_BOUNDS;return false;}
+ size_t count=(size_t)w*h*scale*scale;
+ if(count>PE2_MAX_PIXELS){f->reason=PE2_BOUNDS;return false;}
+#ifdef PE_PS5
+ if(!PeRenderReserve(&f->direct,PE2_MAX_PIXELS*sizeof(uint16_t))){f->reason=PE2_ALLOC;return false;}
+ f->pixels=f->direct.data;f->capacity=PE2_MAX_PIXELS;
+#else
+ if(count>f->capacity){
+  uint16_t *next=realloc(f->pixels,count*sizeof(*next));
+  if(!next){f->reason=PE2_ALLOC;return false;}
+  f->pixels=next;f->capacity=count;
+ }
+#endif
+ f->w=w*f->scale;f->h=h*f->scale;f->page_x=x;f->page_y=y;
+ f->sx0=0;f->sy0=0;f->sx1=f->w;f->sy1=f->h;
+ for(int py=0;py<f->h;++py)for(int px=0;px<f->w;++px)
+  f->pixels[py*f->w+px]=native[(y+py/f->scale)*pitch+x+px/f->scale];
+ f->active=true;return true;
+}
+__attribute__((used,retain)) void Pe2Scissor(Pe2Frame *f,int x0,int y0,int x1,int y1){
+ if(!f || !f->active)return;
+ if(x0 < -2048 || x0>2047 || y0 < -2048 || y0>2047 ||
+    x1 < -2048 || x1>2047 || y1 < -2048 || y1>2047){Pe2Reject(f);return;}
+ /* Native draw area is inclusive. Restrict it to the selected display page. */
+ int a=(x0-f->page_x)*f->scale,b=(y0-f->page_y)*f->scale;
+ int c=(x1-f->page_x+1)*f->scale,d=(y1-f->page_y+1)*f->scale;
+ f->sx0=a<0?0:(a>f->w?f->w:a);f->sy0=b<0?0:(b>f->h?f->h:b);
+ f->sx1=c<0?0:(c>f->w?f->w:c);f->sy1=d<0?0:(d>f->h?f->h:d);
+}
+/* Direct VRAM mutation ownership is independent of draw-area scissor.
+ * Load/move deliberately replace detail with canonical words: no shadow feedback.
+ * Source must be the already-mutated canonical row, preserving native row-order
+ * memmove overlap semantics even for vertically overlapping rectangles. */
+static void Pe2CanonicalSpan(Pe2Frame *f,int x,int y,int w,const uint16_t *row){
+ if(!f || !f->active || f->failed || y<f->page_y || y>=f->page_y+f->h/f->scale)return;
+ int lo=x<f->page_x?f->page_x:x;
+ int hi=x+w;if(hi>f->page_x+f->w/f->scale)hi=f->page_x+f->w/f->scale;
+ for(int nx=lo;nx<hi;++nx){
+  int px=(nx-f->page_x)*f->scale,py=(y-f->page_y)*f->scale;
+  uint16_t c=row[nx-x];
+  for(int ly=0;ly<f->scale;++ly)for(int lx=0;lx<f->scale;++lx)
+   f->pixels[(py+ly)*f->w+px+lx]=c;
+  f->drawn=true;
+ }
+}
+/* Native clear ignores draw scissor and blending but honors preserve-mask;
+ * apply that decision to each independent destination, including bit15. */
+static void Pe2ClearSpan(Pe2Frame *f,int x,int y,int w,uint16_t color,bool preserve){
+ if(!f || !f->active || f->failed || y<f->page_y || y>=f->page_y+f->h/f->scale)return;
+ int lo=x<f->page_x?f->page_x:x;
+ int hi=x+w;if(hi>f->page_x+f->w/f->scale)hi=f->page_x+f->w/f->scale;
+ for(int nx=lo;nx<hi;++nx)for(int lane_y=0;lane_y<f->scale;++lane_y)
+  for(int lane_x=0;lane_x<f->scale;++lane_x){
+   uint16_t *out=&f->pixels[((y-f->page_y)*f->scale+lane_y)*f->w+(nx-f->page_x)*f->scale+lane_x];
+   if(!preserve || !(*out&0x8000)){*out=color;f->drawn=true;}
+  }
+}
+/* Supplied by the canonical backend: matrix and RGB555 clamp order shared. */
+static int Pe2Dither(int x,int y);
+static uint16_t Pe2PackDither(int r,int g,int b,int d);
+static int64_t Pe2Edge(Pe2Vertex a,Pe2Vertex b,int x4,int y4,int denom){
+ return (int64_t)(b.x-a.x)*(y4-a.y*denom)-(int64_t)(b.y-a.y)*(x4-a.x*denom);
+}
+static bool Pe2Top(Pe2Vertex a,Pe2Vertex b){return b.y<a.y || (b.y==a.y && b.x>a.x);}
+/* Dedicated native centered line triangles: RGB uses exact barycentric
+ * truncation, never the polygon's anchor-biased fixed-point attribute planes.
+ * Ordered triangles share the same top-left rule, so their diagonal has one owner. */
+static bool Pe2CenteredLineTriangle(Pe2Frame *f,Pe2Vertex a,Pe2Vertex b,Pe2Vertex c,
+ bool do_dither,Pe2Paint paint){
+ if(!f || !f->active || f->failed)return false;
+ /* VertexXY may include draw offset and the signed endpoint extension.
+  * Its int range is bounded by native Sign11 plus native draw offset. */
+ int64_t area=(int64_t)(b.x-a.x)*(c.y-a.y)-(int64_t)(b.y-a.y)*(c.x-a.x);
+ if(!area)return true;
+ if(area<0){Pe2Vertex t=b;b=c;c=t;area=-area;}
+ int minx=a.x<b.x?a.x:b.x;if(c.x<minx)minx=c.x;
+ int maxx=a.x>b.x?a.x:b.x;if(c.x>maxx)maxx=c.x;
+ int miny=a.y<b.y?a.y:b.y;if(c.y<miny)miny=c.y;
+ int maxy=a.y>b.y?a.y:b.y;if(c.y>maxy)maxy=c.y;
+ minx=(minx-f->page_x)*f->scale;maxx=(maxx-f->page_x)*f->scale;
+ miny=(miny-f->page_y)*f->scale;maxy=(maxy-f->page_y)*f->scale;
+ if(minx<f->sx0)minx=f->sx0;if(miny<f->sy0)miny=f->sy0;
+ if(maxx>f->sx1)maxx=f->sx1;if(maxy>f->sy1)maxy=f->sy1;
+ for(int y=miny;y<maxy;++y)for(int x=minx;x<maxx;++x){
+  int units=2*f->scale;
+  int x4=f->page_x*units+x*2+1,y4=f->page_y*units+y*2+1;
+  int64_t wa=Pe2Edge(b,c,x4,y4,units),wb=Pe2Edge(c,a,x4,y4,units),wc=Pe2Edge(a,b,x4,y4,units);
+  if(wa<0 || (!wa&&!Pe2Top(b,c)) || wb<0 || (!wb&&!Pe2Top(c,a)) ||
+     wc<0 || (!wc&&!Pe2Top(a,b)))continue;
+  int64_t denom=area*units;
+  int r=(int)((wa*a.r+wb*b.r+wc*c.r)/denom);
+  int g=(int)((wa*a.g+wb*b.g+wc*c.g)/denom);
+  int blue=(int)((wa*a.b+wb*b.b+wc*c.b)/denom);
+  int d=do_dither?Pe2Dither(f->page_x+x/f->scale,f->page_y+y/f->scale):0;
+  uint16_t color=Pe2PackDither(r,g,blue,d);
+  if(Pe2Write(paint,&f->pixels[y*f->w+x],color,false))f->drawn=true;
+ }
+ return true;
+}
+/* Flat/Gouraud, untextured/raw/modulated triangles. Vertex coords
+ * remain integer PS1 positions. Coverage is evaluated at (2*lane+1)/(2*scale) native pixels,
+ * native-biased 12-bit UV gradients at each covered subpixel; never sampled from an upscaled
+ * final image. Canonical sampler MUST be read-only and alias-free for epoch.
+ * Aliasing, lines and VRAM mutations
+ * require Pe2Reject; native raster remains the sole feedback authority. */
+__attribute__((used,retain)) bool Pe2Triangle(Pe2Frame *f,Pe2Vertex a,Pe2Vertex b,Pe2Vertex c,
+ bool gouraud,bool do_dither,Pe2PolygonSample sample,void *context,Pe2Paint paint,bool unsupported){
+ if(!f || !f->active || f->failed)return false;
+ if(unsupported){Pe2Reject(f);return false;}
+ Pe2Vertex v[3]={a,b,c};
+ for(int i=0;i<3;++i)if(v[i].x < -2048 || v[i].x>2047 ||
+  v[i].y < -2048 || v[i].y>2047 || v[i].u<0 || v[i].u>255 ||
+  v[i].v<0 || v[i].v>255 || v[i].r<0 || v[i].r>255 ||
+  v[i].g<0 || v[i].g>255 || v[i].b<0 || v[i].b>255){Pe2Reject(f);return false;}
+ int64_t area=(int64_t)(b.x-a.x)*(c.y-a.y)-(int64_t)(b.y-a.y)*(c.x-a.x);
+ if(!area)return true;
+ Pe2Vertex anchor=b.x<=a.x?(c.x<=b.x?c:b):(c.x<a.x?c:a);
+ if(area<0){Pe2Vertex t=b;b=c;c=t;area=-area;}
+ /* Match native truncated gradients and leftmost-vertex half-unit bias.
+  * Quarter samples extend the native integer-position attribute plane. */
+ const int av[5]={a.r,a.g,a.b,a.u,a.v},bv[5]={b.r,b.g,b.b,b.u,b.v};
+ const int cv[5]={c.r,c.g,c.b,c.u,c.v};
+ const int origin[5]={anchor.r,anchor.g,anchor.b,anchor.u,anchor.v};
+ int64_t step_x[5],step_y[5];
+ for(int i=0;i<5;++i){
+  step_x[i]=((int64_t)(bv[i]-av[i])*(c.y-a.y)-(int64_t)(cv[i]-av[i])*(b.y-a.y))*4096/area;
+  step_y[i]=((int64_t)(cv[i]-av[i])*(b.x-a.x)-(int64_t)(bv[i]-av[i])*(c.x-a.x))*4096/area;
+ }
+ int minx=a.x<b.x?a.x:b.x;if(c.x<minx)minx=c.x;
+ int maxx=a.x>b.x?a.x:b.x;if(c.x>maxx)maxx=c.x;
+ int miny=a.y<b.y?a.y:b.y;if(c.y<miny)miny=c.y;
+ int maxy=a.y>b.y?a.y:b.y;if(c.y>maxy)maxy=c.y;
+ minx=(minx-f->page_x)*f->scale;maxx=(maxx-f->page_x)*f->scale;
+ miny=(miny-f->page_y)*f->scale;maxy=(maxy-f->page_y)*f->scale;
+ if(minx<f->sx0)minx=f->sx0;if(miny<f->sy0)miny=f->sy0;
+ if(maxx>f->sx1)maxx=f->sx1;if(maxy>f->sy1)maxy=f->sy1;
+ for(int y=miny;y<maxy;++y)for(int x=minx;x<maxx;++x){
+  int units=2*f->scale;
+  int x4=f->page_x*units+x*2+1,y4=f->page_y*units+y*2+1;
+  int64_t wa=Pe2Edge(b,c,x4,y4,units),wb=Pe2Edge(c,a,x4,y4,units),wc=Pe2Edge(a,b,x4,y4,units);
+  if(wa<0 || (!wa&&!Pe2Top(b,c)) || wb<0 || (!wb&&!Pe2Top(c,a)) ||
+     wc<0 || (!wc&&!Pe2Top(a,b)))continue;
+  int attributes[5];
+  for(int i=0;i<5;++i){
+   /* Rational sample positions preserve the native truncated 12-bit plane.
+    * Floor then 8-bit wrap equals the original power-of-two unsigned path. */
+   int64_t value=(int64_t)(origin[i]*4096+2048)*units+
+       (x4-anchor.x*units)*step_x[i]+(y4-anchor.y*units)*step_y[i];
+   attributes[i]=Pe2Attribute(value,units*4096);
+  }
+  int r=gouraud?attributes[0]:a.r,g=gouraud?attributes[1]:a.g;
+  int blue=gouraud?attributes[2]:a.b;
+  /* Phase is absolute native VRAM, never page-local or scaled output XY.
+   * Both subpixel lanes retain the containing native pixel's matrix cell. */
+  int native_x=f->page_x+x/f->scale,native_y=f->page_y+y/f->scale;
+  int d=do_dither && gouraud ? Pe2Dither(native_x,native_y) : 0;
+  uint16_t texel=Pe2PackDither(r,g,blue,d);
+  if(sample){
+   texel=sample(context,attributes[3],attributes[4],r,g,blue,native_x,native_y);
+   if(!PE2_SAMPLE_VISIBLE(texel))continue;}
+  if(Pe2Write(paint,&f->pixels[y*f->w+x],texel,sample!=NULL))f->drawn=true;
+ }
+ return true;
+}
+/* Axis-aligned native sprites have integer UV origins and unit texel steps.
+ * Quarter/three-quarter destination samples share floor(local position): no
+ * fractional source detail is supplied by this API. Horizontal grid stretching
+ * is deliberately rejected by the caller rather than inventing UV phase. */
+__attribute__((used,retain)) bool Pe2Rectangle(Pe2Frame *f,int ox,int oy,int w,int h,
+ int u,int v,uint16_t color,Pe2Sample sample,void *ctx,Pe2Paint paint,bool unsupported){
+ if(!f || !f->active || f->failed)return false;
+ if(unsupported || ox < -2048 || ox>2047 || oy < -2048 || oy>2047 ||
+    w>32767 || h>32767){Pe2Reject(f);return false;}
+ if(w<=0 || h<=0)return true;
+ int x0=(ox-f->page_x)*f->scale,y0=(oy-f->page_y)*f->scale;
+ int x1=x0+w*f->scale,y1=y0+h*f->scale;
+ if(x0<f->sx0)x0=f->sx0;if(y0<f->sy0)y0=f->sy0;
+ if(x1>f->sx1)x1=f->sx1;if(y1>f->sy1)y1=f->sy1;
+ for(int y=y0;y<y1;++y)for(int x=x0;x<x1;++x){
+  uint16_t c=color;
+  if(sample){
+   int local_x4=(f->page_x-ox)*f->scale+x;
+   int local_y4=(f->page_y-oy)*f->scale+y;
+   c=sample(ctx,(u+local_x4/f->scale)&255,(v+local_y4/f->scale)&255,
+       local_x4,local_y4,f->scale);
+   ++f->material_total;
+   if(!PE2_SAMPLE_VISIBLE(c))continue;
+  }
+  if(Pe2Write(paint,&f->pixels[y*f->w+x],c,sample!=NULL)){
+   f->drawn=true;
+   if(sample && PE2_MATERIAL_USED)++f->material_covered;
+  }
+ }
+ return true;
+}
+
+__attribute__((used,retain)) const uint16_t *Pe2Output(Pe2Frame *f,int page_x,int page_y,int w,int h){
+ if(!f || !f->active || f->failed || !f->drawn)return NULL;
+ if(w<=0 || w>320 || h<=0 || h>240){Pe2RejectReason(f,PE2_PAGE);return NULL;}
+ if(page_x!=f->page_x || page_y!=f->page_y || w*f->scale!=f->w || h*f->scale!=f->h){
+  Pe2RejectReason(f,PE2_PAGE);return NULL;}
+ return f->pixels;
+}
+#endif
diff --git a/psyz/src/platform/cpu-widescreen.h b/psyz/src/platform/cpu-widescreen.h
new file mode 100644
index 0000000..755d12e
--- /dev/null
+++ b/psyz/src/platform/cpu-widescreen.h
@@ -0,0 +1,235 @@
+/* SPDX-License-Identifier: MIT
+ * CPU presentation-only wide drawing. Original protocol is supplied by GPU
+ * dispatch; no replacement camera, texture authority or canonical write path.
+ * Unsqueezed coordinates are algebraically equivalent to the GPU pivot:
+ * x' = x - shift (centred layers use shift=0), crop about width/2.
+ */
+#ifndef PE_CPU_WIDESCREEN_H
+#define PE_CPU_WIDESCREEN_H
+#include <SDL3/SDL_stdinc.h>
+#ifdef PE_PS5
+#define WIDE_WIDTH 432
+#define WIDE_HEIGHT 240
+#define WIDE_PIXELS ((size_t)WIDE_WIDTH*WIDE_HEIGHT*64)
+_Static_assert(WIDE_PIXELS*3<=24u*1024u*1024u,"wide RGB arena cap");
+/* Existing normal sample+RGB arenas and wide 2*sample+RGB: <80 MiB,
+ * including five 128 KiB rounding tails. SDL/atlas decoder heap is separate. */
+_Static_assert(PE2_MAX_PIXELS*5+WIDE_PIXELS*7+5*0x20000<=80u*1024u*1024u,"render arena budget");
+typedef struct {
+ PeRenderBuffer memory;
+ uint16_t *pixels;
+ int x,y,nw,nh,w,h,scale;
+ bool active,failed,drawn;
+ unsigned long long samples,extensions;
+} WidePage;
+static WidePage wide_pages[2];
+static struct {int slot,shift;bool centred,field;double qx,qy;} wide_context={-1};
+static int (*wide_extension)(unsigned,unsigned,unsigned,unsigned,unsigned,uint16_t*);
+void SoftwareRasterizer_SetExtensionSampler(int (*fn)(unsigned,unsigned,unsigned,unsigned,unsigned,uint16_t*)) {wide_extension=fn;}
+void SoftwareRasterizer_WideReject(void) {
+ for(int i=0;i<2;++i)if(wide_pages[i].active)wide_pages[i].failed=true;
+}
+void SoftwareRasterizer_WideReset(void) {
+ wide_context.slot=-1;wide_extension=NULL;
+ for(int i=0;i<2;++i){wide_pages[i].active=false;wide_pages[i].failed=true;
+  if(PeRenderRelease(&wide_pages[i].memory))memset(&wide_pages[i],0,sizeof(WidePage));}
+ (void)PeRenderRelease(&wide_rgb);
