+    // No codec metadata is invented: this is only a spatial strength heuristic.
+    bool boundary=((pixel.x&7)==0)||((pixel.x&7)==7)||((pixel.y&7)==0)||((pixel.y&7)==7);
+    float amount=params.logical_strength.w*(boundary?1.0:0.35);
