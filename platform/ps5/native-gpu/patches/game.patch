+#define PE_CK_S(w,value,lo,hi,exact) do{int32_t ck=pe_checkpoint_s32(&(w),(int32_t)(value),(lo),(hi),(exact));if((w).apply&&(w).ok)(value)=(__typeof__(value))ck;}while(0)
+#endif
