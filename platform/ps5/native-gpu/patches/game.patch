+    if(page==HOST_PAGE_STATES)return 8;
+    if(page==HOST_PAGE_IMAGES)return 9;
+    return 0;
+}
+static const char *Host_ModernRowLabel(int page,int row){
+    static const char *const mods[]={"Background pack","Player texture pack","Gameplay mod master","Manage gameplay mods"};
