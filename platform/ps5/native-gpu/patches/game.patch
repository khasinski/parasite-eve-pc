+    if (s_prev_destroy) s_prev_destroy();
+}
+void pe_ui_gpu_install(void) {
+    s_prev_destroy = Psyz_OverlayDestroyCB(pe_destroy);
+}
+int pe_ui_gpu_ready(void) { return s_win_w > 0 && s_win_h > 0; }
