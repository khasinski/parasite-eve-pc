+}
+
+void pe_ps5_mods_present(SDL_Surface *dst) {
+    const SDL_PixelFormatDetails *fmt;
+    int x, y;
+    s_win_w = s_win_h = 0;
+    if (!dst || !dst->pixels || dst->w <= 0 || dst->h <= 0 ||
+        dst->w > MAX_SIDE || dst->h > MAX_SIDE || dst->pitch < dst->w * 4 ||
+        dst->pitch > MAX_PITCH) return;
