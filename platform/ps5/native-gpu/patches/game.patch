+    static const char *const system[]={"Menu appearance","Menu text","Focus pointer","Disc 1","Disc 2","File setup","Save data","Error reports","Build"};
+    if(page==HOST_PAGE_MODS&&row>=0&&row<4)return mods[row];
+    if(page==HOST_PAGE_STATES&&row>=0&&row<8)return states[row];
+    if(page==HOST_PAGE_IMAGES&&row>=0&&row<9)return system[row];
+    if(page==HOST_PAGE_CHEATS){if(row<3){PeMenuRow *r=Host_AssistRow(row);return r?r->label:"Assist unavailable";}return row==3?"Active this launch":"Prepare checkpoint assists";}
+    return "";
+}
+static int Host_ModernRowKind(int page,int row){
+    if(page==HOST_PAGE_MODS)return row==2?2:row==0||row==3?1:0;
+    if(page==HOST_PAGE_CHEATS)return row<3?2:row==4?1:0;
+    if(page==HOST_PAGE_STATES)return row==3?2:row==2||row==4||row==5||row==6?1:0;
+    if(page==HOST_PAGE_IMAGES)return row<3?2:row<5&&!g_CdImageVolumes[row-3]?1:0;
+    return 0;
+}
