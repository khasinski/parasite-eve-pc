+            }
+            pixel = (pixel & ~(fmt->Rmask | fmt->Gmask | fmt->Bmask)) |
+                (rgb[0] << fmt->Rshift) | (rgb[1] << fmt->Gshift) | (rgb[2] << fmt->Bshift);
