+        PeMenuRow *r=pe_menu_row(i);
+        if(r&&r->mod_id&&!strcmp(r->mod_id,"pe_assists")&&
+           (r->kind==PE_ROW_TOGGLE||r->kind==PE_ROW_CHOICE)){
+            if(found++==index)return r;
