+void CpeModelFillPrepare(CpeModelFillFrame *f,const int16_t *rotation,int preset) {
+    memset(f,0,sizeof(*f));f->preset=preset>=0&&preset<=2?preset:0;
+    if(f->preset!=2||!rotation)return;
+    float n[3]={0};
