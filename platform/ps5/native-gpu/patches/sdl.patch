+static bool CPE_ParseExtent(const char *text, Uint32 *w, Uint32 *h) {
+    Uint32 values[2] = {0,0};
+    for (int part=0; part<2; ++part) {
+        if (*text < '0' || *text > '9') return false;
+        while (*text >= '0' && *text <= '9') {
+            unsigned digit = (unsigned)(*text++ - '0');
+            if (values[part] > 1638 || (values[part] == 1638 && digit > 4)) return false;
+            values[part] = values[part]*10 + digit;
+        }
+        if (!values[part]) return false;
+        if (part == 0) { if (*text++ != 'x') return false; }
+        else if (*text) return false;
+    }
+    *w=values[0]; *h=values[1]; return true;
+}
