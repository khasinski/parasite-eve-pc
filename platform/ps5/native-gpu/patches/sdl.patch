+/* CPE-local policy, not an upstream SDL hint. Native PS5 RADV advertises
+ * 0.0.0.0 until CTS qualification. Admit only this explicit application opt-in
+ * and observed driver identity; never rewrite conformance or device features. */
+static bool CPE_PS5RADVNonconformanceOptIn(const VulkanRenderer *renderer,
+    const VkPhysicalDeviceProperties *properties,
+    const VkPhysicalDeviceDriverPropertiesKHR *driver)
+{
+#if defined(SDL_PLATFORM_PS5)
+    return renderer->cpePS5RADVNonconformantOptIn &&
+        properties->vendorID == 0x1002 &&
+        properties->deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU &&
